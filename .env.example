PORT=8000
HOST=0.0.0.0

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# LLM Configuration
# LLM_PROVIDER: "openai", "anthropic", "gemini", "github_models", "groq", "openrouter"
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_MODEL_NAME=gpt-4o
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct
# Optional, sent as attribution headers on OpenRouter requests (not required for auth)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Comma-separated provider names (e.g. "groq,openrouter") tried in order if the
# primary LLM_PROVIDER errors out (rate limit, payload too large, connection error).
LLM_FALLBACK_PROVIDERS=

# PR review payload limits — bounds diff/RAG-context size sent to the LLM to avoid
# blowing past provider token-per-minute limits on large PRs.
MAX_DIFF_CHARS=24000
MAX_RAG_CONTEXT_CHARS=4000

# RAG Configuration
RAG_ENABLED=true
RAG_DB_PATH=./.rag_db
# RAG_EMBEDDER: "local" | "openai"
RAG_EMBEDDER=local
# RAG_VECTOR_STORE: "chroma" | "qdrant"
RAG_VECTOR_STORE=chroma
RAG_TOP_K=5
RAG_INGEST_CLOSED_PRS=50
QDRANT_URL=
QDRANT_API_KEY=
